            name: 'Yates, Bethan',
            affiliation: 'Wellcome Sanger Institute',
            github: 'https://github.com/BethYates',
            contribution: ['contributor'],
            orcid: 'https://orcid.org/0000-0003-1658-1762',
        ],
    ]
    homePage        = 'https://github.com/sanger-tol/genomenote'
    description     = """Creating standardised genome assembly publications"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.04.0'
    version         = '2.2.0'
    doi             = '10.5281/zenodo.7949384'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1'
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs      = params.monochrome_logs
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
