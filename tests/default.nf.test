nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // Test profile arguments
    config "../conf/test.config"

    test("-profile test") {

        when {
            params {
                outdir  = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: ['pipeline_info/*.{html,json,txt}']
            )

            def stable_name_files = getAllFilesFromDir(
                params.outdir,
                includeDir: true,
                include: [
                    // Meta Data changes between runs
                    "ancestral_plots/GCA_963859965.1_buscopainter_complete_location.tsv_buscopainter.pdf",

                    // Reporting a differing number of Exons per run (difference is 1)
                    "gene/Ceramica_pisi-GCA_963859965.1-2024_04-genes.gff3.stats.csv",
                    "genome_note/GCA_963859965.1.docx",
                    "genome_note/GCA_963859965.1_genome_note_consistent.csv",

                    // Use of `./tmp/nxf.{UNIQUE_STRING}/busco...` paths through file
                    "busco/lepidoptera_odb10/short_summary.json",
                    "busco/lepidoptera_odb10/short_summary.txt",

                    // Tar files
                    "busco/lepidoptera_odb10/fragmented_busco_sequences.tar.gz",
                    "busco/lepidoptera_odb10/hmmer_output.tar.gz",
                    "busco/lepidoptera_odb10/multi_copy_busco_sequences.tar.gz",
                    "busco/lepidoptera_odb10/single_copy_busco_sequences.tar.gz",

                    // Contact maps
                    "contact_maps/higlass/GCA_963859965.1_ilCerPisi1.cool",
                    "contact_maps/higlass/GCA_963859965.1_ilCerPisi1.mcool"
                ]
            )

            def multiqc         = getAllFilesFromDir(params.outdir, include: ["multiqc/*"])
            def genomescope     = getAllFilesFromDir(params.outdir, include: ["genomescope/*"])
            def genome_stats    = getAllFilesFromDir(params.outdir, include: ["genome_stats/*"])
            def genome_note_1   = getAllFilesFromDir(params.outdir, include: ["genome_note/*_inconsistent.csv"])
            def genome_note_2   = getAllFilesFromDir(params.outdir, include: ["genome_note/GCA_963859965.1.csv"])
            def pretext_output  = getAllFilesFromDir(params.outdir, include: ["contact_maps/pretext/*"])
            def higlass_output  = getAllFilesFromDir(params.outdir, include: ["contact_maps/higlass/GCA_963859965.1_ilCerPisi1.mcool"])
            def busco_output    = getAllFilesFromDir(params.outdir, include: ["busco/lepidoptera_odb10/*.tsv"])
            def btk_plot_output = getAllFilesFromDir(params.outdir, include: ["blobtoolkit_plots/*.png"])

            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),

                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomenote_software_mqc_versions.yml"),

                    // Files which have stable names - but not stable content
                    stable_name_files,

                    // All files with stable contents
                    multiqc,
                    genomescope,
                    genome_stats,
                    genome_note_1,
                    genome_note_2,
                    pretext_output,
                    higlass_output,
                    busco_output,
                    btk_plot_output

                ).match() }
            )
        }
    }
}
