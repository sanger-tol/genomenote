{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/sanger-tol/genomenote/main/assets/schema_input.json",
    "title": "sanger-tol/genomenote pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "description": "Sample identifier",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "datatype": {
                "type": "string",
                "pattern": "^\\S+$",
                "enum": ["hic", "pacbio", "10x", "haplotype"],
                "errorMessage": "Data type must be one of: hic, pacbio, 10x, haplotype",
                "meta": ["datatype"]
            },
            "datafile": {
                "type": "string",
                "format": "path",
                "exists": true,
                "pattern": "^\\S+$",
                "errorMessage": "Data path for reads or kmer"
            }
        },
        "required": ["sample", "datatype", "datafile"]
    }
}
